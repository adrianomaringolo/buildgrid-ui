{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"lib": ["dom", "esnext"],
		"jsx": "react-jsx",
		"strict": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"rootDir": "./src",
		"outDir": "dist",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["vitest/globals", "@testing-library/jest-dom"],
		"paths": {
			"@/*": ["./src/*"],
			"buildgrid-ui/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"dist",
		".husky",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.stories.tsx",
		"webiste"
	]
}
